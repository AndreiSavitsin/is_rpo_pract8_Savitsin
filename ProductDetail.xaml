<Page x:Class="is_rpo_pract8_Savitsin.ProductDetail"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:is_rpo_pract8_Savitsin"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductDetail">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition MinWidth="300" MaxWidth="500"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>

        <Border CornerRadius="15" Background="DarkOrange" Grid.Column="1" Grid.Row="1">
            <StackPanel>
                <Image Grid.Row="0" Grid.Column="0" Source="{Binding PathPhoto}" Width="200" Height="150" Stretch="Uniform"/>
                <TextBlock Text="{Binding Name}"/>
                <TextBlock Text="{Binding Price}"/>
                <TextBlock TextWrapping="Wrap" MaxWidth="350" Text="{Binding Description}"/>
                <TextBlock Text="{Binding Category}"/>
                <Button Content="Добавить в корзину" Click="btnAddToBasket"/>
            </StackPanel>
        </Border>
        
    </Grid>
</Page>

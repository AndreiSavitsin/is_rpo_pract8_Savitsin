<Page x:Class="is_rpo_pract8_Savitsin.ProductDetail"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:is_rpo_pract8_Savitsin"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductDetail">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="15" Padding="10" Margin="0,0,15,15">
            <Image Source="{Binding PathPhoto}" Width="300" Height="250" Stretch="Uniform"/>
        </Border>

        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="28" FontWeight="Bold" Style="{StaticResource ProductTextBlock}"/>
            <TextBlock Text="{Binding Price, StringFormat={}{0} ₽}" FontSize="22" Foreground="DarkOrange" FontWeight="SemiBold" Style="{StaticResource ProductTextBlock}"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="DarkOrange" CornerRadius="15" Padding="15">
            <StackPanel>
                <TextBlock Text="Описание:" FontWeight="Bold"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left"/>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <TextBlock Text="{Binding Category, StringFormat=Категория: {0}}" Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding Brand, StringFormat=Бренд: {0}}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Количество:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="txtQuantity" Width="50" Height="30" Text="1" TextAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button Content="Добавить в корзину" Click="btnAddToBasket" Margin="20,0,0,0" Width="200"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
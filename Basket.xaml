<Page x:Class="is_rpo_pract8_Savitsin.Basket"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:is_rpo_pract8_Savitsin"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Basket">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ListView Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="10"
                  x:Name="BasketListView"
                  ItemsSource="{Binding BasketItems}"
                  SelectedItem="{Binding SelectedItem}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="250">
                        <GridViewColumn.Header>
                            <TextBlock Text="Название" Foreground="Black" FontWeight="Bold"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Product.Name}" Foreground="Black"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="120">
                        <GridViewColumn.Header>
                            <TextBlock Text="Цена" Foreground="Black" FontWeight="Bold"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Product.Price, StringFormat={}{0} ₽}" Foreground="Black"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="150">
                        <GridViewColumn.Header>
                            <TextBlock Text="Кол-во" Foreground="Black" FontWeight="Bold"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="-" Style="{StaticResource SmallButtonStyle}" Click="DecreaseQuantity_Click"/>
                                    <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" MinWidth="20" TextAlignment="Center" Foreground="Black" FontWeight="Bold"/>
                                    <Button Content="+" Style="{StaticResource SmallButtonStyle}" Click="IncreaseQuantity_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="150">
                        <GridViewColumn.Header>
                            <TextBlock Text="Сумма" Foreground="Black" FontWeight="Bold"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalPrice, StringFormat={}{0} ₽}" Foreground="Black"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="5,10,10,10" CornerRadius="15" Background="DarkOrange">
            <StackPanel>
                <TextBlock Text="Введите промокод"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox Foreground="White" FontSize="18" x:Name="txtPromocode" Width="140"/>
                    <Button Content="ОК" Width="50" Click="ApplyPromocode_Click"/>
                </StackPanel>

                <TextBlock Text="Итоговая сумма заказа"/>
                <TextBlock Text="{Binding TotalSum, StringFormat={}{0} ₽}" FontWeight="Bold" FontSize="20"/>

                <Button Content="Оформить заказ" Click="btnMakeOrder"/>
                <Button Content="Продолжить покупки" Click="btnContinueShopping"/>
                <Button Content="Удалить товар" Click="btnDel"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
<Page x:Class="is_rpo_pract8_Savitsin.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:is_rpo_pract8_Savitsin"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Home">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="125"/>
            <RowDefinition Height="170"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0">
            <TextBlock Text="Поиск товаров" />
            <StackPanel Orientation="Horizontal">
                <TextBox FontSize="18" x:Name="txtInput" Width="500"/>
                <Button Click="Search_Click" Content="Найти"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Column="1" Grid.Row="1" Width="350" Height="150" Background="DarkOrange" CornerRadius="25" Opacity="0">
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:1.5"/>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Приветствуем Вас в нашем магазине электроники! У нас огромный ассортимент и лучшие цены!" 
                       TextWrapping="Wrap" MaxWidth="300"
                       TextAlignment="Center"/>

                <Button Click="Catalog_Click" Style="{StaticResource NavigationButton}" Content="Перейти в каталог"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
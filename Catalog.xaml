<Page x:Class="is_rpo_pract8_Savitsin.Catalog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:is_rpo_pract8_Savitsin"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Catalog">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="10" Background="DarkOrange" CornerRadius="20" Height="350" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center" Text="Панель фильтров" FontSize="18" FontWeight="Bold"/>

                <TextBlock Text="Сортировка:" Margin="5,10,5,0"/>
                <Button Click="btnSortByPrice" Content="По цене"/>
                <Button Click="btnSortByCategory" Content="По категории"/>
                <Button Click="btnSortByBrand" Content="По бренду"/>
                <Button Click="btnReset" Content="Сбросить" Margin="5,15,5,5"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ListView Margin="5"
                      x:Name="ProductsListView"
                      ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}"
                      MouseDoubleClick="Product_Click"
                      PreviewMouseLeftButtonDown="ListView_PreviewMouseLeftButtonDown">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock TextWrapping="Wrap" MaxWidth="100" Grid.Row="0" Grid.Column="1" Style="{StaticResource ProductTextBlock}" Text="{Binding Name}"/>
                                <TextBlock TextWrapping="Wrap" MaxWidth="100" Grid.Row="1" Grid.Column="0" Style="{StaticResource ProductTextBlock}" Text="{Binding Price, StringFormat={}{0} ₽}"/>
                                <Image Grid.Row="0" Grid.Column="0" Source="{Binding PathPhoto}" Width="200" Height="150" Stretch="Uniform"/>

                                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Добавить в корзину" 
                                        Margin="0,5,0,0" Click="btnAddToCart_Click" Width="200"/>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
    </Grid>
</Page>
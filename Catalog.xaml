<Page x:Class="is_rpo_pract8_Savitsin.Catalog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:is_rpo_pract8_Savitsin"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Catalog">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <ListView Grid.Column="1" Width="350" Margin="5"
                  ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct}"
                  MouseDoubleClick="Product_Click">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock TextWrapping="Wrap" MaxWidth="100" Grid.Row="0" Grid.Column="1" Style="{StaticResource ProductTextBlock}" Text="{Binding Name}"/>
                            <TextBlock TextWrapping="Wrap" MaxWidth="100" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource ProductTextBlock}" Text="{Binding Price}"/>
                            <Image Grid.Row="0" Grid.Column="0" Source="{Binding PathPhoto}" Width="200" Height="150" Stretch="Uniform"/>
                        </Grid>
                        
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Column="2" Margin="10" Background="DarkOrange" CornerRadius="20" Height="225" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center" Text="Панель фильтров" FontSize="18"/>
                <Button Click="btnSortByPrice" Content="По цене"/>
                <Button Click="btnSortByCategory" Content="По категории"/>
                <Button Click="btnSortByBrand" Content="По бренду"/>
            </StackPanel>
        </Border>
        

    </Grid>
</Page>

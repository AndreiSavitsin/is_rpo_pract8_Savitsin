<Page x:Class="is_rpo_pract8_Savitsin.Contacts"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:is_rpo_pract8_Savitsin"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Contacts">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="Auto" MinWidth="300" MaxWidth="500"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="Auto" MinHeight="200" MaxHeight="500"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="1" Grid.Row="1" CornerRadius="15" Background="DarkOrange">
            <StackPanel>
                <TextBlock Text="«ГигаБайт» — магазин оригинальной электроники 
                           с официальной гарантией, быстрой доставкой по Екатеринбургу 
                           и помощью в выборе техники под любые задачи." TextWrapping="Wrap" MaxWidth="220"/>
                <TextBlock Text="Адрес: г. Екатеринбург, ул. Малышева, д. 51, оф. 204
                           Режим работы: Ежедневно, 10:00 – 21:00
                           Телефон: +7 (343) 000-00-00
                           Email: info@gigabyte-ekb.ru" TextWrapping="Wrap"
                           MaxWidth="220"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
